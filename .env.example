# SQLite file (relative to prisma/). For PostgreSQL, change provider in schema.prisma and migrate.
DATABASE_URL="file:./dev.db"
# Private uploads directory (outside /public). Must be persistent storage in production.
UPLOAD_DIR="./storage/uploads"
# "true" enables one-click demo sign-in for seeded demo accounts and the simulated checkout. Never enable in production.
DEMO_MODE="true"
# Optional: shift the app clock (minutes) for demos/tests.
KHANA_BRIDGE_CLOCK_OFFSET_MIN="0"

# --- Vercel (set in the project's Environment Variables) ---
# DATABASE_URL="postgres://..."   # Neon or Vercel Postgres; use the pooled URL with ?pgbouncer=true&connection_limit=1 if pooled
# CRON_SECRET="long-random-string" # protects /api/cron
# SEED_DEMO=1 (first deploy only), DEMO_MODE=true, DEMO_IN_PRODUCTION=true  # public demo with fictional data
